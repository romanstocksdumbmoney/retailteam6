PORT=5000
FRONTEND_PORT=3000
APP_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# Feature defaults
DEFAULT_PLAN=free
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
OWNER_EMAIL=
OWNER_EMAILS=
# Keep disabled unless you intentionally want dev-wide owner preview.
OWNER_PREVIEW_IN_DEV=0

# Stripe billing
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID=price_your_monthly_pro_price_id
# Optional fallback used when STRIPE_PRICE_ID is not set:
# Stripe Checkout will create an inline recurring monthly line item.
STRIPE_PRO_MONTHLY_PRICE_CENTS=1500
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Account access code email delivery (for Pro recovery code flow)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DumbDollars <no-reply@dumbdollars.local>"
ACCESS_CODE_TTL_MINUTES=15
# Keep disabled so free accounts cannot self-upgrade via code flow.
ACCESS_CODE_ALLOW_FREE_UPGRADE=0
# In non-production, when SMTP is not configured, return preview code in API response.
ACCESS_CODE_PREVIEW_FALLBACK=1

# Notification bot real delivery
# Keep enabled if you want hard-fail when no real channel delivers.
NOTIFICATION_REQUIRE_REAL_DELIVERY=1
# Email automation (free signup promo + pro update digest)
# If set to 1, email automation send fails when SMTP cannot deliver.
EMAIL_AUTOMATION_REQUIRE_REAL_DELIVERY=0
# Optional dedicated persistence file path:
# EMAIL_AUTOMATION_STORE_FILE=/workspace/data/email-automation.json
# Optional notification-specific SMTP (falls back to SMTP_* values above).
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_SECURE=0
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_SMTP_FROM="DumbDollars Notifications <no-reply@dumbdollars.local>"
# Twilio SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Data provider placeholders
ALPHAVANTAGE_API_KEY=your_alpha_vantage_api_key
# If your frontend is Vite/Next in another setup, these are also supported by MarketDataService:
# VITE_MARKET_API_KEY=your_alpha_vantage_api_key
# MARKET_API_KEY=your_alpha_vantage_api_key
# NEXT_PUBLIC_MARKET_API_KEY=your_alpha_vantage_api_key
# REACT_APP_MARKET_API_KEY=your_alpha_vantage_api_key
UNUSUAL_WHALES_API_KEY=your_unusual_whales_api_key
FMP_API_KEY=your_fmp_api_key
ZACKS_API_KEY=your_zacks_api_key
TRADEFEEDS_API_KEY=your_tradefeeds_api_key
